# ==============================================================================
# Dispatchly Client Environment Variables (Frontend / Vercel)
# ==============================================================================
# Note: In Next.js, only variables prefixed with NEXT_PUBLIC_ are exposed to the browser.
# DO NOT place server secrets, database keys, or private tokens in this file.

# Backend HTTP API URL (point to your InsForge Compute container deployment, including /api suffix)
# Example: https://dispatchly-api.fly.dev/api or https://your-service.insforge.app/api
NEXT_PUBLIC_API_URL=https://your-compute-service.insforge.app/api

# Backend Real-Time Gateway URL (direct WebSocket connection to Compute, NO /api suffix)
# Example: https://dispatchly-api.fly.dev or https://your-service.insforge.app
NEXT_PUBLIC_SOCKET_URL=https://your-compute-service.insforge.app

# Demo Mode Toggle (Optional: set to "false" in production to hide demo one-click logins and test license buttons)
NEXT_PUBLIC_DEMO_MODE=false
