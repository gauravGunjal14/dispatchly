# ==============================================================================
# Dispatchly Server Environment Variables (Backend / InsForge Compute Container)
# ==============================================================================

# Core Server Configuration
PORT=5000
NODE_ENV=production

# Frontend Client Origins (comma-separated, drive Express CORS and Socket.IO CORS)
# Must include your exact Vercel production URL (e.g. https://dispatchly.vercel.app)
CLIENT_URL=https://your-production-app.vercel.app

# Set to true to allow dynamic Vercel preview branch deployments (*.vercel.app)
ALLOW_VERCEL_PREVIEWS=false

# Demo Mode Toggle (MUST be "false" in production to reject demo account bootstrapping and fixed passwords)
DEMO_MODE=false

# Database: MongoDB Atlas Connection String
# Use a separate database name for production (e.g. dispatchly_prod) with a least-privilege DB user
MONGODB_URI=mongodb+srv://<db_username>:<db_password>@<cluster>.mongodb.net/dispatchly_prod?retryWrites=true&w=majority

# Authentication: Secure JWT Secrets (generate using: openssl rand -base64 48)
JWT_ACCESS_SECRET=replace_with_a_secure_random_base64_secret_minimum_32_characters
JWT_REFRESH_SECRET=replace_with_a_different_secure_random_base64_secret_minimum_32_characters
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# Storage: Cloud S3 Storage Driver (REQUIRED in production because container disks are ephemeral)
# Supports AWS S3, Cloudflare R2, MinIO, or Wasabi
STORAGE_DRIVER=s3
AWS_ACCESS_KEY_ID=your_aws_access_key_id
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key
AWS_REGION=us-east-1
AWS_S3_BUCKET=your-private-dispatchly-uploads-bucket
# Optional custom S3-compatible endpoint (for Cloudflare R2 or MinIO)
# AWS_S3_ENDPOINT=https://<account_id>.r2.cloudflarestorage.com

# Initial Administrator Bootstrap (used only by npm run create:admin)
ADMIN_EMAIL=admin@yourdomain.com
ADMIN_PASSWORD=your_secure_initial_admin_password_min_8_chars
ADMIN_NAME=Platform Administrator
ADMIN_PHONE=+1 415-555-0100
