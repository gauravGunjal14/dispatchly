# Server Environment Variables
PORT=5000
NODE_ENV=production
CLIENT_URL=https://your-client.insforge.site,http://localhost:3000
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/dispatchly?retryWrites=true&w=majority
JWT_ACCESS_SECRET=your_jwt_access_secret_key_minimum_32_characters
JWT_REFRESH_SECRET=your_jwt_refresh_secret_key_minimum_32_characters
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d
PLATFORM_FEE_AMOUNT=1.50
OFFER_EXPIRY_SECONDS=60
USE_IN_MEMORY_DB=false
